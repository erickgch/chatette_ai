# Virtual environment
.venv/

# Sensitive files
.env
token.pickle
credentials.json
*-credentials.json
*.onnx
*.onnx.json

# Logs
*.log
service.log

# Editor
.vscode/

# Runtime data
core/memory/memory_store.json

# All user data (notes, chroma_db, sync state, caches)
data/
core/data/

# Python cache
__pycache__/
*.pyc

# PyCharm
.idea/
# Backups of .env (contain secrets too) — env.template.txt is not affected
.env.*

# Recovery sheet with every secret — never commit (see CHATETTE_RECOVERY.txt)
CHATETTE_RECOVERY*
